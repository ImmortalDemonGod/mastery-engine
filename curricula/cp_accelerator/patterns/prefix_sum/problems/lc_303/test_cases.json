{
  "problem": "Range Sum Query - Immutable",
  "source": "https://leetcode.com/problems/range-sum-query---immutable/",
  "note": "Adapted to functional interface: sumRange(nums, left, right) returns sum of nums[left..right].",
  "tests": [
    {
      "id": 1,
      "input": { "nums": [-2, 0, 3, -5, 2, -1], "left": 0, "right": 2 },
      "expected": 1,
      "note": "Example 1: sum(-2, 0, 3) = 1"
    },
    {
      "id": 2,
      "input": { "nums": [-2, 0, 3, -5, 2, -1], "left": 2, "right": 5 },
      "expected": -1,
      "note": "Example 2: sum(3, -5, 2, -1) = -1"
    },
    {
      "id": 3,
      "input": { "nums": [-2, 0, 3, -5, 2, -1], "left": 0, "right": 5 },
      "expected": -3,
      "note": "Example 3: sum of entire array = -3"
    },
    {
      "id": 4,
      "input": { "nums": [1, 2, 3, 4, 5], "left": 0, "right": 4 },
      "expected": 15,
      "note": "Edge case: sum of entire positive array"
    },
    {
      "id": 5,
      "input": { "nums": [1, 2, 3, 4, 5], "left": 2, "right": 2 },
      "expected": 3,
      "note": "Edge case: single element range"
    },
    {
      "id": 6,
      "input": { "nums": [10], "left": 0, "right": 0 },
      "expected": 10,
      "note": "Edge case: single element array"
    }
  ]
}