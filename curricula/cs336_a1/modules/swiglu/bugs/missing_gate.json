{
  "id": "swiglu-missing-gate",
  "description": "Gate branch reuses w1 instead of w3, so the SwiGLU gating is wrong.",
  "injection_type": "ast",
  "engine_version": "2.1",
  "target_function": "forward",
  "logic": [
    {
      "pass": 1,
      "type": "find_and_replace",
      "pattern": {
        "node_type": "Assign",
        "targets": [
          {
            "node_type": "Name",
            "id": "b"
          }
        ],
        "value": {
          "node_type": "Call",
          "func": {
            "node_type": "Attribute",
            "attr": "w3"
          }
        }
      },
      "replacement": {
        "type": "replace_value_with",
        "source": "self.w1(in_features)"
      }
    }
  ]
}
