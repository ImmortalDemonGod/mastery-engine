{
  "id": "softmax-no-subtract-max",
  "description": "Removes the subtract-max step (keeps only the raw input before exp), so large logits overflow exp() to inf and the softmax becomes NaN.",
  "injection_type": "ast",
  "engine_version": "2.1",
  "target_function": "softmax",
  "logic": [
    {
      "pass": 1,
      "type": "find_and_replace",
      "pattern": {
        "node_type": "Assign",
        "value": {
          "node_type": "BinOp",
          "op": "Sub",
          "left": { "node_type": "Name" }
        }
      },
      "replacement": {
        "type": "replace_value_with",
        "source": "node.value.left"
      }
    }
  ]
}
