{
  "id": "rmsnorm-missing-keepdim",
  "description": "mean() over the last dim without keepdim=True, breaking the broadcast.",
  "injection_type": "ast",
  "engine_version": "2.1",
  "target_function": "forward",
  "logic": [
    {
      "pass": 1,
      "type": "find_and_replace",
      "pattern": {
        "node_type": "Call",
        "func": {
          "node_type": "Attribute",
          "attr": "mean"
        }
      },
      "replacement": {
        "type": "remove_keyword_arg",
        "name": "keepdim"
      }
    }
  ]
}
